    <!-- Home - ADB Permission -->
    <string name="home_adb_permission_title">ADB Wireless Debugging</string>
    <string name="home_adb_permission_description"><![CDATA[Why ADB mode?<br>Background processes require ADB privileges. This mode connects directly to the device\'s wireless debugging service without requiring Shizuku or Root.<br><br>Prerequisites:<br>1. Enable <b>Wireless Debugging</b> in Developer Options<br>2. <b>Pair</b> this app with the device<br>3. <b>Connect</b> to the ADB service]]></string>
    <string name="home_adb_permission_button_pair">ADB Pair</string>
    <!-- ADB Pairing Tutorial -->
    <string name="adb_pairing_tutorial_title">Pair with your device</string>
    <string name="adb_pairing_tutorial_notification">A notification will help you complete the pairing.</string>
    <string name="adb_pairing_tutorial_notification_blocked">The pairing process needs you to interact with a notification. Please allow this app to post notifications.</string>
    <string name="adb_pairing_tutorial_step1">Enter \"Developer options\" - \"Wireless debugging\". Tap \"Pair device with pairing code\", you will see a six-digit code.</string>
    <string name="adb_pairing_tutorial_step1_hint">Please note, left part of the \"Wireless debugging\" option is clickable, tapping it will open a new page. Only turning on the switch on the right is incorrect.</string>
    <string name="adb_pairing_tutorial_step2">Enter the pairing code in the notification to complete pairing.</string>
    <string name="adb_pairing_tutorial_step3">Return to this app and connect.</string>
